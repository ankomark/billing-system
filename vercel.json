{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend/wifi-billing-frontend && npm install",
  "buildCommand": "cd frontend/wifi-billing-frontend && npm run build",
  "outputDirectory": "frontend/wifi-billing-frontend/build",
  "build": {
    "env": {
      "REACT_APP_API_URL": "https://api.smartbillsolution.com/api/"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.tile.openstreetmap.org; font-src 'self' data:; connect-src 'self' https://api.smartbillsolution.com; frame-src https://api.smartbillsolution.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
