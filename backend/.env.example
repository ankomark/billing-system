# Copy to .env and fill in. .env is gitignored — never commit real values.
#   cp .env.example .env
#
# docker-compose.yml reads this file both for env_file and for ${...}
# interpolation, so FLOWER_BASIC_AUTH below reaches the flower command.

# ── Core ─────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────────
# Host is the compose service name, not localhost, when running in compose.
#
# Two roles, deliberately. POSTGRES_USER below is unprivileged and is the one
# Django connects as; compose creates it on first init. A Postgres superuser
# bypasses Row-Level Security no matter what the policies say, so connecting as
# one silently turns off every tenant_isolation policy in the database —
# see docker/postgres-init/10-app-role.sh.
POSTGRES_DB=wifi_billing
POSTGRES_USER=wifi_app
POSTGRES_PASSWORD=change-me-app
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
CONN_MAX_AGE=60

# Bootstrap superuser, used by compose to create the database and the role
# above. The application never uses it. Give it a different password.
POSTGRES_ADMIN_PASSWORD=change-me-admin

# ── Redis / Celery ───────────────────────────────────────────────────────────
# DB layout: 0 = Celery broker, 1 = Django cache, 2 = Celery results.
REDIS_URL=redis://redis:6379

# ── Serving ──────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=4

# Flower basic auth, as user:password. REQUIRED — compose refuses to start
# without it rather than exposing Flower unauthenticated. Flower shows raw task
# arguments, which for this project includes customer phone numbers and M-Pesa
# references, so treat it as sensitive.
FLOWER_BASIC_AUTH=admin:change-me

# ── TLS ──────────────────────────────────────────────────────────────────────
# With DEBUG=False, Django 301-redirects every request to HTTPS. The compose
# stack terminates no TLS, so leave this False when running compose directly,
# and remove it (or set True) once a TLS proxy fronts the app.
# Django admin login still needs HTTPS either way, because SESSION_COOKIE_SECURE
# stays on. The JWT API works fine over plain HTTP.
SECURE_SSL_REDIRECT=False

# ── Field encryption ─────────────────────────────────────────────────────────
# Encrypts RouterDevice.password and Customer.pppoe_password at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes existing encrypted values unreadable.
FIELD_ENCRYPTION_KEY=

# ── Frontend origin ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── M-Pesa ───────────────────────────────────────────────────────────────────
# Primary values are read from the SystemSetting table (Admin > Settings).
# These are only fallbacks used before the DB is populated.
MPESA_ENV=sandbox
MPESA_SHORTCODE=
# Allow callbacks from 127.0.0.1 during local testing. Must be False in production.
MPESA_ALLOW_LOCAL_CALLBACK=False

# ── Notifications (fallbacks; prefer Admin > Settings) ───────────────────────
AT_USERNAME=
AT_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Data caps ────────────────────────────────────────────────────────────────
# Set to 1 for the first deploy that enables cap enforcement, then remove it.
#
# Caps were never enforced before -- the sweep was written and never scheduled
# -- so the first run does not find the few subscribers who went over in the
# last five minutes. It finds everyone who has gone over since their current
# subscription started and disconnects them all inside one beat interval, each
# with an SMS. That backlog is unknown until it is measured.
#
# With this set, the sweep logs "DRY RUN: would cut off ..." and touches
# nothing -- no suspension, no router, no message. `manage.py report_usage_caps`
# answers the same question in one go and also changes nothing.
#
# Unset (the default) is enforcing. Leave it that way once you have looked.
# USAGE_CAPS_DRY_RUN=1

# ── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=
ENVIRONMENT=production
