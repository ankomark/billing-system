[Unit]
Description=Apply tunnel peer requests from the billing platform
After=wg-quick@wg0.service
Wants=wg-quick@wg0.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/wg-peer-watcher

# Root is needed for `wg set` and for writing /etc/wireguard/wg0.conf, and
# that is the entire reason this runs out here instead of in the container.
# Everything not needed for those two things is taken away.
ProtectSystem=strict
ReadWritePaths=/etc/wireguard /var/spool/wg-requests

# read-only, not true. `true` makes /home an empty directory, and
# wg-add-peer.sh lives at /home/deploy/ — the unit would fail to execute it
# and report it as a missing file, which sends you looking at the path rather
# than at the sandbox. Install the peer script under /usr/local/bin and set
# WG_ADD_PEER if you would rather have this fully off.
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
